---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import type { ContentTypeId } from '../../config/content';
import { siteConfig } from '../../config/site';
import EntryList from '../content/EntryList.astro';
import ViewAll from '../ui/ViewAll.astro';

interface HomeSection {
  id: ContentTypeId;
  title: string;
  href: string;
  entries: Array<CollectionEntry<any>>;
}

export interface EvidenciaApartado {
  id: string;
  title: string;
  icon: string;
  description: string;
  href: string;
  badge: string;
  highlight?: boolean;
}

interface Props {
  locale: Locale;
  sections: HomeSection[];
  introVideo?: string;
  evidenciasApartados?: EvidenciaApartado[];
  evidenciasHref?: string;
}

const { locale, sections, introVideo, evidenciasApartados, evidenciasHref } = Astro.props;
const { author } = siteConfig;

function assetPath(path: string) {
  if (/^(https?:)?\/\//.test(path) || path.startsWith('data:')) return path;
  const base = import.meta.env.BASE_URL || '/';
  return `${base.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
}

const avatarSrc = assetPath(author.avatar);
---

<section class="py-8 sm:py-10">
  <div class="profile-card surface-card px-7 py-5 sm:px-8 sm:py-6">
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left">
      <img
        src={avatarSrc}
        alt={author.name}
        class="h-24 w-24 shrink-0 rounded-full border-4 border-primary/20 object-cover shadow-sm"
      />

      <div class="min-w-0 flex-1">
        <h1 class="text-3xl font-bold tracking-tight">{author.name}</h1>
        <p class="mt-1.5 text-lg text-muted-foreground">{author.title[locale]}</p>
        <p class="mt-3 leading-relaxed text-foreground">{author.description[locale]}</p>

        {author.social.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2.5 md:justify-start">
            {author.social.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-[var(--radius-control)] bg-muted px-3 py-2 text-sm font-medium text-muted-foreground transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-primary/10 hover:text-primary"
                title={item.name}
              >
                <Icon name={item.icon} class="h-4 w-4" />
                <span>{item.name}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

{introVideo && (
  <section class="py-4 sm:py-6 flex justify-center">
    <div class="relative w-48 h-48 sm:w-64 sm:h-64 rounded-full overflow-hidden border-4 border-primary/20 shadow-lg group">
      <video
        src={assetPath(introVideo)}
        controls
        autoplay
        muted
        loop
        playsinline
        class="w-full h-full object-cover rounded-full"
        aria-label={locale === 'es' ? 'Video de introducción' : locale === 'zh-cn' ? '介绍视频' : 'Introduction video'}
      >
        {locale === 'es' ? 'Tu navegador no soporta el elemento de video.' : locale === 'zh-cn' ? '您的浏览器不支持 video 元素。' : 'Your browser does not support the video element.'}
      </video>
    </div>
  </section>
)}

{evidenciasApartados && evidenciasApartados.length > 0 && (
  <section class="py-8">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold">Evidencias – Bases de Datos I</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Acceso directo a las evidencias académicas: modelado conceptual, normalización, SQL y proyecto final.
        </p>
      </div>
      {evidenciasHref && <ViewAll href={evidenciasHref} locale={locale} />}
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {evidenciasApartados.map((item) => (
        <a
          href={item.href}
          class="group flex flex-col gap-3 rounded-[var(--radius-card)] border border-border bg-card p-5 shadow-[var(--surface-shadow)] transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[var(--surface-shadow-strong)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/25"
        >
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="text-2xl" aria-hidden="true">{item.icon}</span>
              <h3 class="text-base font-semibold leading-snug text-foreground transition-colors group-hover:text-primary">
                {item.title}
              </h3>
            </div>
            <span class:list={[
              'rounded-full px-2.5 py-0.5 text-xs font-medium',
              item.highlight
                ? 'bg-primary/10 text-primary border border-primary/20'
                : 'bg-muted text-muted-foreground border border-border'
            ]}>
              {item.badge}
            </span>
          </div>

          <p class="text-xs text-muted-foreground leading-relaxed">
            {item.description}
          </p>

          <div class="mt-auto flex items-center justify-end text-xs font-medium text-primary">
            <span>Ingresar al apartado</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

{sections.map((section) => (
  section.entries.length > 0 && (
    <section class="py-8">
      <div class="mb-3 flex items-end justify-between gap-4">
        <h2 class="text-2xl font-semibold">{section.title}</h2>
        <ViewAll href={section.href} locale={locale} />
      </div>
      <EntryList entries={section.entries} collection={section.id} locale={locale} />
    </section>
  )
))}
