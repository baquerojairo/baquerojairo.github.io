---
/**
 * EvidenciaCard.astro
 * Componente reutilizable para mostrar un trabajo académico.
 *
 * Props:
 *   title       - Título del trabajo
 *   description - Descripción corta (opcional)
 *   driveUrl    - Enlace de Google Drive (con permiso público)
 *   embed       - Si true, muestra un iframe de previsualización debajo del título
 *   date        - Fecha del trabajo (opcional)
 */

interface Props {
  title: string;
  description?: string;
  driveUrl: string;
  embed?: boolean;
  date?: Date;
}

const { title, description, driveUrl, embed = false, date } = Astro.props;

// Convierte el enlace estándar de Drive a formato /preview para el iframe.
// Entrada:  https://drive.google.com/file/d/FILE_ID/view?usp=sharing
// Salida:   https://drive.google.com/file/d/FILE_ID/preview
function toPreviewUrl(url: string): string {
  const match = url.match(/\/file\/d\/([^/]+)/);
  if (match) return `https://drive.google.com/file/d/${match[1]}/preview`;
  // Si ya es /preview o es otro formato, devuelve tal cual
  return url;
}

const previewUrl = toPreviewUrl(driveUrl);

const dateStr = date
  ? new Intl.DateTimeFormat('es', { year: 'numeric', month: 'long', day: 'numeric' }).format(date)
  : undefined;
---

<div class="rounded-[var(--radius-card)] border border-border bg-card p-5 shadow-[var(--surface-shadow)] flex flex-col gap-4">
  {/* Encabezado */}
  <div class="flex flex-col gap-1">
    <h3 class="text-lg font-semibold leading-snug text-foreground">{title}</h3>
    {dateStr && (
      <time class="text-xs text-muted-foreground">{dateStr}</time>
    )}
    {description && (
      <p class="mt-1 text-sm text-muted-foreground leading-relaxed">{description}</p>
    )}
  </div>

  {/* iframe de previsualización (opcional) */}
  {embed && (
    <div class="w-full overflow-hidden rounded-[var(--radius-panel)] border border-border bg-muted">
      {/* 
        El iframe muestra el archivo de Drive en modo previsualización.
        allow-same-origin y allow-scripts son necesarios para que Drive funcione.
        No uses allow-popups-to-escape-sandbox para mantener seguridad.
      */}
      <iframe
        src={previewUrl}
        class="w-full"
        style="height: 480px;"
        loading="lazy"
        title={title}
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
      ></iframe>
    </div>
  )}

  {/* Botón "Ver trabajo" */}
  <div class="mt-auto">
    {driveUrl && driveUrl !== '#' ? (
      <a
        href={driveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-primary bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
      >
        {/* Icono de enlace externo */}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        Ver trabajo
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-muted/60 px-3 py-1.5 text-xs font-medium text-muted-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Enlace pendiente
      </span>
    )}
  </div>
</div>
